#!/usr/bin/env python3
"""cut.py — finance creator clip pipeline.

For each clip in a job file:
  1. Extract the clip from the source via ffmpeg (frame-accurate re-encode).
  2. Transcribe with faster-whisper at word granularity (VERBATIM — never paraphrased).
  3. For each variant in variants.json:
       a. Ask local Ollama for hook / chyron / CTA overlays.
       b. Emit a styled .ass caption track from the verbatim word timings.
       c. Render the final variant with ffmpeg (captions + drawtext overlays).

Captions are built directly from whisper word objects. The LLM never sees a caption
slot — it only produces the editorial overlays. That keeps captions verbatim by
construction.
"""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
import textwrap
from dataclasses import dataclass
from pathlib import Path
from urllib import request as urlrequest


OLLAMA_URL = "http://localhost:11434/api/generate"
DEFAULT_VARIANTS_PATH = Path(__file__).parent / "variants.json"

ASPECT_RES = {"9:16": (1080, 1920), "1:1": (1080, 1080), "16:9": (1920, 1080)}


# ---------- data ----------

@dataclass
class Word:
    text: str
    start: float
    end: float


@dataclass
class ClipSpec:
    id: str
    start: float
    end: float
    topic: str


# ---------- helpers ----------

def run(cmd):
    print(f"$ {' '.join(str(c) for c in cmd)}", file=sys.stderr)
    subprocess.run(cmd, check=True)


def parse_time(value) -> float:
    if isinstance(value, (int, float)):
        return float(value)
    s = str(value).strip()
    if ":" not in s:
        return float(s)
    parts = [float(p) for p in s.split(":")]
    if len(parts) == 2:
        return parts[0] * 60 + parts[1]
    if len(parts) == 3:
        return parts[0] * 3600 + parts[1] * 60 + parts[2]
    raise ValueError(f"unrecognized time: {value!r}")


# ---------- source acquisition ----------

def ensure_source(job: dict, work_dir: Path) -> Path:
    src = job["source"]
    src_type = job.get("source_type", "local")
    if src_type == "local":
        p = Path(src).expanduser()
        if not p.is_file():
            sys.exit(f"source file not found: {p}")
        return p
    if src_type == "youtube":
        out = work_dir / "source.mp4"
        if out.exists():
            return out
        run([
            "yt-dlp",
            "-f", "bestvideo[height<=1080]+bestaudio/best",
            "--merge-output-format", "mp4",
            "-o", str(out),
            src,
        ])
        return out
    sys.exit(f"unknown source_type: {src_type}")


# ---------- clip extraction ----------

def extract_clip(source: Path, spec: ClipSpec, out_path: Path):
    # Re-encode rather than stream-copy so cuts land on the requested frame.
    run([
        "ffmpeg", "-y",
        "-ss", f"{spec.start:.3f}",
        "-to", f"{spec.end:.3f}",
        "-i", str(source),
        "-c:v", "libx264", "-preset", "veryfast", "-crf", "18",
        "-c:a", "aac", "-b:a", "192k",
        str(out_path),
    ])


# ---------- transcription ----------

def transcribe(clip_path: Path, model_name: str) -> list[Word]:
    from faster_whisper import WhisperModel  # lazy: heavy import

    model = WhisperModel(model_name, device="auto", compute_type="auto")
    segments, _ = model.transcribe(
        str(clip_path),
        word_timestamps=True,
        vad_filter=True,
        condition_on_previous_text=False,
        beam_size=5,
    )
    words: list[Word] = []
    for seg in segments:
        for w in (seg.words or []):
            text = w.word.strip()
            if not text:
                continue
            words.append(Word(text=text, start=float(w.start), end=float(w.end)))
    if not words:
        raise RuntimeError(f"no speech transcribed from {clip_path}")
    return words


# ---------- Ollama overlays ----------

OLLAMA_SYSTEM = (
    "You write short on-screen text overlays for a finance video clip. "
    "Return STRICT JSON with keys hook, chyron, cta. "
    "hook = 3-7 words. chyron = 2-4 words. cta = 3-6 words. "
    "You MUST NOT modify, rephrase, or quote the transcript — overlays are "
    "editorial graphics, separate from the captions. Match the persona exactly. "
    "No emoji, no hashtags, no quotation marks in output values."
)


def llm_overlays(model: str, persona: str, topic: str, transcript: str) -> dict:
    prompt = textwrap.dedent(f"""
        Persona: {persona}

        Editorial topic (framing only, do not literally quote): {topic}

        Clip transcript (verbatim, FOR CONTEXT ONLY — never paraphrase into overlays):
        \"\"\"{transcript}\"\"\"

        Return JSON: {{"hook": "...", "chyron": "...", "cta": "..."}}
    """).strip()
    body = json.dumps({
        "model": model,
        "prompt": prompt,
        "system": OLLAMA_SYSTEM,
        "format": "json",
        "stream": False,
        "options": {"temperature": 0.7},
    }).encode()
    req = urlrequest.Request(
        OLLAMA_URL, data=body, headers={"Content-Type": "application/json"}
    )
    with urlrequest.urlopen(req, timeout=180) as resp:
        payload = json.loads(resp.read())
    data = json.loads(payload.get("response", "").strip())
    for key in ("hook", "chyron", "cta"):
        if not isinstance(data.get(key), str) or not data[key].strip():
            raise ValueError(f"LLM output missing/invalid {key!r}: {data!r}")
    return {k: data[k].strip() for k in ("hook", "chyron", "cta")}


# ---------- ASS subtitle building ----------

ASS_HEADER = """[Script Info]
ScriptType: v4.00+
PlayResX: {res_x}
PlayResY: {res_y}
ScaledBorderAndShadow: yes
WrapStyle: 2

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
Style: Base,{font},{fontsize},{primary},{secondary},{outline},{back},{bold},0,0,0,100,100,0,0,{border_style},{outline_w},{shadow},{alignment},60,60,{margin_v},1
Style: Highlight,{font},{fontsize},{highlight},{secondary},{outline},{back},{bold},0,0,0,100,100,0,0,{border_style},{outline_w},{shadow},{alignment},60,60,{margin_v},1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
"""


def fmt_ass_time(t: float) -> str:
    h = int(t // 3600)
    m = int((t % 3600) // 60)
    s = t - h * 3600 - m * 60
    return f"{h}:{m:02d}:{s:05.2f}"


def ass_escape(text: str) -> str:
    return (
        text.replace("\\", "\\\\")
            .replace("{", "\\{")
            .replace("}", "\\}")
            .replace("\n", "\\N")
    )


def group_phrases(words: list[Word], max_words: int, max_dur: float) -> list[list[Word]]:
    phrases: list[list[Word]] = []
    cur: list[Word] = []
    for w in words:
        if not cur:
            cur = [w]
            continue
        if len(cur) >= max_words or (w.end - cur[0].start) > max_dur:
            phrases.append(cur)
            cur = [w]
        else:
            cur.append(w)
    if cur:
        phrases.append(cur)
    return phrases


def build_ass(words: list[Word], variant: dict, res: tuple[int, int]) -> str:
    res_x, res_y = res
    style = variant["subtitle_style"]
    mode = variant.get("caption_mode", "lower_third")

    header = ASS_HEADER.format(
        res_x=res_x,
        res_y=res_y,
        font=style["font"],
        fontsize=style["font_size"],
        primary=style["primary_color"],
        secondary=style.get("secondary_color", "&H000000FF"),
        outline=style["outline_color"],
        back=style.get("back_color", "&H80000000"),
        bold=1 if style.get("bold", True) else 0,
        border_style=style.get("border_style", 1),
        outline_w=style.get("outline_width", 3),
        shadow=style.get("shadow", 1),
        alignment=style.get("alignment", 2),
        margin_v=style.get("margin_v", 120),
        highlight=style.get("highlight_color", style["primary_color"]),
    )

    lines: list[str] = []

    if mode == "karaoke_word":
        # One word at a time, full-screen, in the Highlight style.
        # Verbatim: each Word.text is rendered as-is.
        for w in words:
            lines.append(
                f"Dialogue: 0,{fmt_ass_time(w.start)},{fmt_ass_time(w.end)},"
                f"Highlight,,0,0,0,,{ass_escape(w.text)}"
            )
    elif mode == "lower_third":
        # Short phrases in a static lower-third bar.
        for phrase in group_phrases(words, max_words=7, max_dur=3.0):
            full = " ".join(w.text for w in phrase)
            lines.append(
                f"Dialogue: 0,{fmt_ass_time(phrase[0].start)},"
                f"{fmt_ass_time(phrase[-1].end)},Base,,0,0,0,,{ass_escape(full)}"
            )
    else:  # "subtitles" — traditional, longer phrases, no per-word effect.
        for phrase in group_phrases(words, max_words=12, max_dur=4.5):
            full = " ".join(w.text for w in phrase)
            lines.append(
                f"Dialogue: 0,{fmt_ass_time(phrase[0].start)},"
                f"{fmt_ass_time(phrase[-1].end)},Base,,0,0,0,,{ass_escape(full)}"
            )

    return header + "\n".join(lines) + "\n"


# ---------- final render ----------

def aspect_to_filter(aspect: str) -> str:
    if aspect == "9:16":
        return "scale=-2:1920,crop=1080:1920"
    if aspect == "1:1":
        return "scale=-2:1080,crop=1080:1080"
    if aspect == "16:9":
        return "scale=1920:-2,crop=1920:1080"
    return ""


# macOS-default font paths; override per-variant via overlay_style.<role>_fontfile.
FONT_FALLBACK = {
    "Impact": "/System/Library/Fonts/Supplemental/Impact.ttf",
    "Helvetica": "/System/Library/Fonts/Helvetica.ttc",
    "Georgia": "/System/Library/Fonts/Supplemental/Georgia.ttf",
}


def font_path(overlay_style: dict, role: str) -> str:
    explicit = overlay_style.get(f"{role}_fontfile")
    if explicit:
        if not Path(explicit).is_file():
            raise FileNotFoundError(
                f"font file not found for {role}: {explicit}"
            )
        return explicit
    name = overlay_style.get(f"{role}_font", "Helvetica")
    candidate = FONT_FALLBACK.get(name)
    if not candidate or not Path(candidate).is_file():
        raise FileNotFoundError(
            f"no system font file resolved for {role}={name!r}; "
            f"set overlay_style.{role}_fontfile in variants.json"
        )
    return candidate


def _filter_quote(value: str) -> str:
    # Wrap a value in single quotes for ffmpeg's filtergraph. Inside single
    # quotes ffmpeg treats EVERY character literally except `'` itself, which
    # ends the quote. The canonical way to embed an apostrophe is the
    # close-escape-reopen idiom: 'I'\''M' -> I'M.
    return "'" + value.replace("'", "'\\''") + "'"


def drawtext_filter(text, *, fontfile, size, color, box_color, y) -> str:
    # drawtext-level escapes: backslash first, then % (which drawtext expands
    # for built-in variables like %{n}). These run BEFORE filtergraph quoting.
    inner = text.replace("\\", "\\\\").replace("%", "\\%")
    return (
        f"drawtext=fontfile={_filter_quote(fontfile)}"
        f":text={_filter_quote(inner)}"
        f":fontsize={size}:fontcolor={color}"
        f":box=1:boxcolor={box_color}:boxborderw=20"
        f":x=(w-text_w)/2:y={y}"
    )


def escape_ass_filter_path(p: Path) -> str:
    return str(p).replace(":", "\\:").replace("'", "\\'")


def render_variant(
    clip_path: Path,
    ass_path: Path,
    overlays: dict,
    variant: dict,
    aspect: str,
    out_path: Path,
):
    ostyle = variant.get("overlay_style", {})
    chyron_text = overlays["chyron"]
    if variant.get("chyron_uppercase", True):
        chyron_text = chyron_text.upper()

    hook_f = drawtext_filter(
        overlays["hook"],
        fontfile=font_path(ostyle, "hook"),
        size=ostyle.get("hook_size", 64),
        color=ostyle.get("hook_color", "white"),
        box_color=ostyle.get("hook_box", "black@0.5"),
        y="h*0.08",
    )
    chyron_f = drawtext_filter(
        chyron_text,
        fontfile=font_path(ostyle, "chyron"),
        size=ostyle.get("chyron_size", 40),
        color=ostyle.get("chyron_color", "white"),
        box_color=ostyle.get("chyron_box", "#FF6A00@0.9"),
        y="h-th-200",
    )
    cta_f = drawtext_filter(
        overlays["cta"],
        fontfile=font_path(ostyle, "cta"),
        size=ostyle.get("cta_size", 48),
        color=ostyle.get("cta_color", "white"),
        box_color=ostyle.get("cta_box", "black@0.6"),
        y="h-th-60",
    )

    vf = ",".join(filter(None, [
        aspect_to_filter(aspect),
        f"ass={escape_ass_filter_path(ass_path)}",
        hook_f,
        chyron_f,
        cta_f,
    ]))

    run([
        "ffmpeg", "-y",
        "-i", str(clip_path),
        "-vf", vf,
        "-c:v", "libx264", "-preset", "medium", "-crf", "20",
        "-c:a", "aac", "-b:a", "192k",
        "-movflags", "+faststart",
        str(out_path),
    ])


# ---------- main ----------

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("job", type=Path, help="Path to job JSON")
    ap.add_argument("--variants", type=Path, default=DEFAULT_VARIANTS_PATH)
    ap.add_argument("--keep-temp", action="store_true")
    ap.add_argument(
        "--source",
        help="Override job['source']. Local path or YouTube URL. "
             "Source type is auto-detected (http(s)://... -> youtube, else local). "
             "Use --source-type to force.",
    )
    ap.add_argument(
        "--source-type",
        choices=["local", "youtube"],
        help="Force the source type. Otherwise inferred from --source.",
    )
    args = ap.parse_args()

    job = json.loads(args.job.read_text())
    variants_all = json.loads(args.variants.read_text())

    if args.source:
        job["source"] = args.source
        if args.source_type:
            job["source_type"] = args.source_type
        else:
            job["source_type"] = (
                "youtube" if args.source.startswith(("http://", "https://"))
                else "local"
            )
    elif args.source_type:
        sys.exit("--source-type requires --source")

    selected = job.get("variants") or list(variants_all.keys())
    missing = [v for v in selected if v not in variants_all]
    if missing:
        sys.exit(f"unknown variants: {missing}")

    clips = [
        ClipSpec(
            id=c["id"],
            start=parse_time(c["start"]),
            end=parse_time(c["end"]),
            topic=c.get("topic", ""),
        )
        for c in job["clips"]
    ]
    if len(clips) != 5:
        print(f"warning: expected 5 clips, got {len(clips)}", file=sys.stderr)

    out_dir = Path(job.get("output_dir", "out")).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)
    work_dir = out_dir / ".work"
    work_dir.mkdir(parents=True, exist_ok=True)

    source = ensure_source(job, work_dir)
    aspect = job.get("aspect", "9:16")
    if aspect not in ASPECT_RES:
        sys.exit(f"unsupported aspect: {aspect}")
    res = ASPECT_RES[aspect]

    llm_model = job.get("llm_model", "llama3.1:8b")
    whisper_model = job.get("whisper_model", "large-v3")

    for spec in clips:
        clip_path = work_dir / f"{spec.id}.mp4"
        if not clip_path.exists():
            extract_clip(source, spec, clip_path)

        print(f"[{spec.id}] transcribing with {whisper_model}", file=sys.stderr)
        words = transcribe(clip_path, whisper_model)
        transcript = " ".join(w.text for w in words)
        (work_dir / f"{spec.id}.transcript.txt").write_text(transcript)

        for vname in selected:
            variant = variants_all[vname]
            print(f"[{spec.id}/{vname}] overlays via {llm_model}", file=sys.stderr)
            overlays = llm_overlays(
                model=llm_model,
                persona=variant["llm_persona"],
                topic=spec.topic,
                transcript=transcript,
            )
            (work_dir / f"{spec.id}.{vname}.overlays.json").write_text(
                json.dumps(overlays, indent=2)
            )

            ass_path = work_dir / f"{spec.id}.{vname}.ass"
            ass_path.write_text(build_ass(words, variant, res))

            out_path = out_dir / f"{spec.id}_{vname}.mp4"
            render_variant(clip_path, ass_path, overlays, variant, aspect, out_path)
            print(f"  -> {out_path}", file=sys.stderr)

    if not args.keep_temp:
        shutil.rmtree(work_dir, ignore_errors=True)


if __name__ == "__main__":
    main()
